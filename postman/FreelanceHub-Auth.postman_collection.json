{
  "info": {
    "_postman_id": "d4d1f6b6-6b16-4e16-9c2a-0f1f0c2e6f01",
    "name": "FreelanceHub - Auth",
    "description": "Authentication flow for FreelanceHub API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "saraToken",
      "value": ""
    },
    {
      "key": "ahmedToken",
      "value": ""
    },
    {
      "key": "laylaToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register - Sara Client",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sara Client\",\n  \"email\": \"sara.client@test.com\",\n  \"password\": \"SaraPass123!\",\n  \"role\": \"CLIENT\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Registration succeeded', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Access token exists', function () {",
              "    pm.expect(json.accessToken).to.be.a('string');",
              "});",
              "pm.test('Password is not exposed', function () {",
              "    pm.expect(json).to.not.have.property('password');",
              "});",
              "if (json.accessToken) {",
              "    pm.collectionVariables.set('saraToken', json.accessToken);",
              "}"
            ]
          }
        }
      ]
    },
