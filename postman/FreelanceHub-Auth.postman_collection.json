      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const json = pm.response.json();",
              "pm.test('Password is not exposed', function () {",
              "    pm.expect(json).to.not.have.property('password');",
              "});",
              "pm.test('Current user has expected role', function () {",
              "    pm.expect(json.role).to.eql('CLIENT');",
              "});"
            ]
          }
        }
      ]
