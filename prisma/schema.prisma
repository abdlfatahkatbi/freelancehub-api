generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  FREELANCER
  ADMIN
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ContractStatus {
  HELD
  RELEASED
}

enum TransactionType {
  DEPOSIT
  ESCROW_HOLD
  PAYOUT
  COMMISSION
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  isBanned  Boolean  @default(false)
  createdAt DateTime @default(now())

  profile             FreelancerProfile?
  wallet              Wallet?
  projects            Project[]  @relation("ClientProjects")
  proposals           Proposal[]
  clientContracts     Contract[] @relation("ContractClient")
  freelancerContracts Contract[] @relation("ContractFreelancer")
}

model FreelancerProfile {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio        String?
  hourlyRate Decimal? @db.Decimal(10, 2)
  avatarPath String?
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  projects Project[]
}

model Project {
  id             Int           @id @default(autoincrement())
  title          String
  description    String
  budget         Decimal       @db.Decimal(12, 2)
  status         ProjectStatus @default(OPEN)
  attachmentPath String?
  attachmentMime String?
  createdAt      DateTime      @default(now())

  clientId   Int
  client     User     @relation("ClientProjects", fields: [clientId], references: [id])
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  proposals Proposal[]
  contract  Contract?

  @@index([status, categoryId, createdAt])
  @@index([clientId])
}

model Proposal {
  id           Int            @id @default(autoincrement())
  price        Decimal        @db.Decimal(12, 2)
  durationDays Int
  message      String
  status       ProposalStatus @default(PENDING)
  createdAt    DateTime       @default(now())

  projectId    Int
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancerId Int
  freelancer   User    @relation(fields: [freelancerId], references: [id])

  contract Contract?

  @@unique([projectId, freelancerId])
  @@index([freelancerId])
}

model Wallet {
  id      Int     @id @default(autoincrement())
  userId  Int     @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance Decimal @default(0) @db.Decimal(12, 2)

  transactions Transaction[]
}

model Transaction {
  id           Int             @id @default(autoincrement())
  walletId     Int
  wallet       Wallet          @relation(fields: [walletId], references: [id])
  type         TransactionType
  amount       Decimal         @db.Decimal(12, 2) // signed: ESCROW_HOLD is negative
  balanceAfter Decimal         @db.Decimal(12, 2)
  contractId   Int?
  contract     Contract?       @relation(fields: [contractId], references: [id])
  createdAt    DateTime        @default(now())

  @@index([walletId, createdAt])
}

model Contract {
  id           Int            @id @default(autoincrement())
  amount       Decimal        @db.Decimal(12, 2)
  commission   Decimal?       @db.Decimal(12, 2)
  status       ContractStatus @default(HELD)
  createdAt    DateTime       @default(now())
  releasedAt   DateTime?

  projectId    Int      @unique
  project      Project  @relation(fields: [projectId], references: [id])
  proposalId   Int      @unique
  proposal     Proposal @relation(fields: [proposalId], references: [id])
  clientId     Int
  client       User     @relation("ContractClient", fields: [clientId], references: [id])
  freelancerId Int
  freelancer   User     @relation("ContractFreelancer", fields: [freelancerId], references: [id])

  delivery     Delivery?
  transactions Transaction[]
}

model Delivery {
  id         Int      @id @default(autoincrement())
  contractId Int      @unique
  contract   Contract @relation(fields: [contractId], references: [id])
  filePath   String
  mime       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
